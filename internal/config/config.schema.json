{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Secure MCP Server Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "tools"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "handler"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "handler": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
